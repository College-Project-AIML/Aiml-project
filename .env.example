# ============================================================
# Aiml-project — environment variables
# Copy to .env and adjust for your machine.
# ============================================================

# --- Database ---------------------------------------------------------------
DATABASE_URL=postgresql://admin:securepassword@localhost:5433/aiml_core

# --- API --------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:5173
SECRET_KEY=CHANGE_ME
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# --- Ingestion pipeline -----------------------------------------------------
OUTPUT_PATH=data/gov/karnataka/schemes.json
DUMP_PATH=scholarships_api_dump.json
DEDUP_SIMILARITY_THRESHOLD=0.95

# --- Live sync (docs/next.md) ----------------------------------------------
# Master switch — the APScheduler jobs only start when this is true.
LIVE_SYNC_ENABLED=false

# MyScheme connector — the API endpoint + public x-api-key below were captured
# from the site's own JS bundles (the public website sends them on every request).
# Override only if the portal rotates them.
MYSCHEME_API_URL=https://api.myscheme.gov.in/search/v6/schemes
MYSCHEME_API_KEY=tYTy5eEhlu9rFjyxuCr7ra7ACp4dv1RH8gWuHTDc
MYSCHEME_RATE_LIMIT_SECONDS=2
MYSCHEME_PAGE_SIZE=100
MYSCHEME_MAX_PAGES=200
MYSCHEME_POLL_INTERVAL_MIN=360

# Karnataka SSP connector (public landing pages only).
SSP_BASE_URL=https://ssp.karnataka.gov.in
SSP_PAGE_DELAY_SECONDS=3
SSP_USE_PLAYWRIGHT=false
SSP_POLL_INTERVAL_MIN=240

# Change detection.
LIVE_SYNC_MISS_THRESHOLD=2

# Raw snapshot + run-report locations.
RAW_DATA_ROOT=data/raw
SYNC_LOG_DIR=data/sync_logs
