# .env.example

# --- APPS ---
NODE_ENV=development
PORT=3000

# --- DATABASES (Docker Internal URLs) ---
# PostgreSQL (User Data)
POSTGRES_USER=admin
POSTGRES_PASSWORD=securepassword
POSTGRES_DB=aiml_core
POSTGRES_HOST=postgres
POSTGRES_PORT=5433
DATABASE_URL=postgresql://admin:securepassword@localhost:5432/aiml_core

# MongoDB (Scheme Data)
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=securepassword
MONGO_URI=mongodb://admin:securepassword@localhost:27017/aiml_schemes

# Redis (Cache)
REDIS_HOST=redis
REDIS_PORT=6379

# Qdrant (Vector DB for AI)
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# --- API KEYS (Leave empty in example) ---
OPENAI_API_KEY=
HF_TOKEN=