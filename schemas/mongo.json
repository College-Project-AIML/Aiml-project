{
  "$jsonSchema": {
    "bsonType": "object",
    "required": ["name", "ministry", "type", "benefits"],
    "properties": {
      "name": { "bsonType": "string" },
      "ministry": { "bsonType": "string" },
      "description": { "bsonType": "string" },
      
      "type": { 
        "enum": ["financial", "scholarship", "loan", "subsidy", "skill_training"] 
      },

      "benefits": {
        "bsonType": "array",
        "description": "List of clear benefits (e.g., '₹5000 per month')",
        "items": { "bsonType": "string" }
      },

      "eligibility_rules": {
        "bsonType": "object",
        "description": "Structured rules for the Code Engine to check",
        "properties": {
          "min_age": { "bsonType": "int" },
          "max_age": { "bsonType": "int" },
          "max_income": { "bsonType": "double" },
          "gender": { "bsonType": "array" },
          "state": { "bsonType": "array" },
          "caste": { "bsonType": "array" },
          "occupation": { "bsonType": "array" }
        }
      },

      "documents_required": {
        "bsonType": "array",
        "items": { "bsonType": "string" }
      },

      "application_link": { "bsonType": "string" },
      "is_active": { "bsonType": "bool" }
    }
  }
}